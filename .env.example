# Copy this file to .env and put your own values in it. Never commit .env.

# PostgreSQL connection used by Prisma and by the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# Port of this API. The web app calls http://localhost:3001 unless told otherwise.
PORT=3001

# Web addresses allowed to call this API from a browser, separated by commas.
# Empty or missing means: http://localhost:3000 only.
CORS_ORIGIN=http://localhost:3000

# Address of scheduler-brain (the Python solver). Timetables are sent to <address>/solve.
SOLVER_URL=http://127.0.0.1:8000

# How long to wait for scheduler-brain, in seconds (1800 = 30 minutes). 0 means no limit.
SOLVER_TIMEOUT_SECONDS=1800
